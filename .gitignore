# 데이터베이스 — 업무 내용이 들어 있으므로 커밋하지 않는다
*.db
*.db-journal
*.db-wal

# 비밀정보 (Anthropic API 키 등)
.streamlit/secrets.toml
.env

# 녹음 파일과 전사 결과 — 회의 음성은 저장소에 올리지 않는다
recordings/
transcripts/
*.m4a
*.mp3
*.wav
*.amr

# 파이썬
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 브레인스토밍 산출물
.superpowers/

# OS
Thumbs.db
desktop.ini
.DS_Store

# 프론트엔드
node_modules/
dist/
.env.local
.env.*.local

# Supabase CLI 임시 파일 — 연결 정보와 원격 버전 캐시. 사람마다 다르다
supabase/.temp/
supabase/.branches/

# ⚠️ AI 열쇠가 들어 있는 파일. 절대 커밋하지 않는다.
#    supabase/.env.example 은 값이 없는 틀이라 커밋해도 된다 (아래에서 되살린다)
supabase/.env
supabase/.env.*
!supabase/.env.example
supabase/functions/.env
supabase/functions/**/.env
