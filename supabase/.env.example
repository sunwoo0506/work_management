# ============================================================
# AI 공급자 설정 — Edge Function 에만 들어간다
#
# ⚠️ 이 파일을 그대로 쓰지 않는다. 옆에 `.env` 를 만들어 값을 채운다.
#        supabase/.env      ← 실제 값. git 에 안 올라간다 (.gitignore)
#        supabase/.env.example ← 이 파일. 값 없이 이름만
#
# ⚠️ 이 값들은 **브라우저로 가지 않는다.**
#    frontend/.env.local 에 넣으면 안 된다 — 그쪽은 화면 소스에 실린다.
#    여기 값은 Supabase 서버에만 올라가고, 브라우저는 Edge Function 을 부를 뿐이다.
#
#        브라우저 → Edge Function → AI 공급자
#                   (열쇠가 있는 유일한 자리)
#
# 넣는 방법 (프로젝트 루트에서)
#        npx supabase secrets set --env-file supabase/.env
#
# 확인 (값은 안 보이고 이름과 지문만 나온다)
#        npx supabase secrets list
#
# 바꾸거나 지울 때
#        npx supabase secrets unset OPENAI_API_KEY
# ============================================================

# 열쇠. sk- 로 시작한다.
# https://platform.openai.com/api-keys 에서 만든다.
OPENAI_API_KEY=

# 공급자. 지금은 openai 하나뿐이다.
# 바꾸려면 supabase/functions/_shared/provider/ 에 어댑터를 하나 더 넣는다.
AI_PROVIDER=openai

# 모델 — 코드에 박지 않는다 (CLAUDE.md). 아직 확정 전이다 (설계서 §14 OQ-12).
#   AI_MODEL       판단이 섞인 일 — 질문에 답하기, 문서 초안
#   AI_MODEL_LIGHT 가벼운 일 — 체크리스트 추리기 같은 뽑아내기
# 비워 두면 코드의 기본값(gpt-5.6-sol)을 쓴다.
AI_MODEL=gpt-5.6-sol
AI_MODEL_LIGHT=gpt-5.6-terra

# ── 받아쓰기 (회의록) ────────────────────────────────────────
#
# 받아쓰기 모델은 **화면에서 사용자가 고른다** (2026-09-05).
#   기록 › 회의록 › 🎙 실시간   — 「받아쓰기 시작」 전에 고른다
#   기록 › 회의록 › 녹음파일    — 「변환 시작」 전에 고른다
#   회의록 상세 › 변환하지 못한 음성 — 같은 소리를 다른 모델로 다시 돌려 견준다
#
# 아래 값은 **화면이 아무것도 안 보냈을 때**만 쓰인다.
# 비워 두면 코드의 기본값(whisper-1)을 쓴다.
AI_MODEL_TRANSCRIBE=whisper-1

# 제미나이 받아쓰기(gemini-3.5-transcribe)를 쓰려면 필요하다.
# https://aistudio.google.com/apikey 에서 만든다.
# ⚠️ 안 넣으면 화면에서 제미나이를 골라도 「열쇠가 없습니다」로 막힌다.
#    OpenAI 모델(whisper-1 · gpt-transcribe)은 이 값 없이도 돈다.
GEMINI_API_KEY=

# 고를 수 있는 모델을 잠그고 싶을 때만 쓴다. 쉼표로 잇는다.
# 비워 두면 모양만 맞으면 통과시킨다 — 새 모델을 써 보려고 배포를 다시 하지 않아도 되게.
AI_TRANSCRIBE_MODELS=
